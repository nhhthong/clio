#!/usr/bin/env python3
"""clio — the one entry point to Clio's scripts. Python 3.9+, standard library only.
  clio test <cmd> ...      run cases, record evidence, gate a task     (skills/test/scripts/clio_test.py)
  clio q <cmd> ...         every read of Clio's ledgers, read-only      (skills/context/scripts/q.py)
  clio validate [mode]     check index.jsonl / debt.jsonl / the repo    (skills/memo/scripts/validate.py)
  clio add <plan|test> <area> | index | debt   the writer of the ledgers      (skills/lib/clio_add.py)
  clio setup <check|run>   create .claude/clio/ in a project            (skills/setup/scripts/setup.py)
  clio doc                 create or update a task doc from one JSON object (skills/memo/scripts/doc.py)
Each subcommand prints its own usage when called without arguments. The hooks are not routed
here: hooks.json calls hooks/clio_guard.py and hooks/clio_nudge.py directly."""
import importlib.util
import os
import sys

sys.dont_write_bytecode = True   # keep the plugin directory free of __pycache__
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
CMDS = {
    "test": "skills/test/scripts/clio_test.py",
    "q": "skills/context/scripts/q.py",
    "validate": "skills/memo/scripts/validate.py",
    "add": "skills/lib/clio_add.py",
    "doc": "skills/memo/scripts/doc.py",
    "setup": "skills/setup/scripts/setup.py",
}


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd not in CMDS:
        print(__doc__.split("\n", 1)[1].rstrip(), file=sys.stderr)
        return 1
    path = os.path.join(ROOT, CMDS[cmd])
    spec = importlib.util.spec_from_file_location("clio_" + cmd, path)
    mod = importlib.util.module_from_spec(spec)
    sys.argv = [path] + argv[1:]
    spec.loader.exec_module(mod)
    return mod.main(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
