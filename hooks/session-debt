#!/usr/bin/env bash
# SessionStart hook — surface open, actionable debt before work starts, and say when CONTEXT.md
# has fallen behind the ledger. Silent unless this project uses the .claude structure.
set -uo pipefail
input=$(cat)
cwd=$(jq -r '.cwd // ""' <<<"$input" 2>/dev/null)
[ -d "$cwd/.claude/clio" ] || exit 0
debt="$cwd/.claude/clio/debt.jsonl"
idx="$cwd/.claude/clio/index.jsonl"
ctx="$cwd/.claude/CONTEXT.md"

# 1. open debt — newest first, actionable (blocked_by null) capped at five
if [ -s "$debt" ]; then
  open=$(jq -s -c 'group_by(.id) | map(last) | sort_by(.date) | reverse | .[]
                   | select(.status!="done")' "$debt" 2>/dev/null) || open=""
  if [ -n "$open" ]; then
    act=$(printf '%s\n' "$open" | jq -r 'select(.blocked_by==null)
      | "- \(.id) [\(.kind)] \(.what[0] // "?")\(if (.code[0]? // "") != "" then " → \(.code[0])" else "" end)"')
    n_act=$(printf '%s' "$act" | grep -c . || true)
    n_all=$(printf '%s\n' "$open" | grep -c . || true)
    n_blk=$((n_all - n_act))
    echo "OPEN DEBT (.claude/clio/debt.jsonl):"
    [ "$n_act" -gt 0 ] && printf '%s\n' "$act" | head -5
    [ "$n_act" -gt 5 ] && echo "  …$((n_act - 5)) more actionable"
    [ "$n_blk" -gt 0 ] && echo "  ($n_blk blocked — blocked_by non-null, do not start)"
    echo "Full list + kinds: run /debt"
  fi
fi

# 2. CONTEXT.md staleness — five or more documented runs dated after its last write
if [ -f "$ctx" ] && [ -s "$idx" ]; then
  m=$(stat -c %Y "$ctx" 2>/dev/null || stat -f %m "$ctx" 2>/dev/null)
  d=$(date -u -d "@$m" +%F 2>/dev/null || date -u -r "$m" +%F 2>/dev/null)
  n=$(jq -r --arg d "$d" 'select(.date > $d) | .doc' "$idx" 2>/dev/null | grep -c . || true)
  [ "${n:-0}" -ge 5 ] && echo "CONTEXT.md unchanged across $n documented runs since $d — the next /clio-memo should propose an update (WRAP-UP § CONTEXT.md)."
fi
exit 0
