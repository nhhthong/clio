#!/usr/bin/env bash
# Stop hook — nudge ONCE if this session changed code but never recorded it.
# Reads the working tree, not the transcript: edits made through Bash (sed, heredoc,
# scripts) never appear as Edit/Write tool calls.
set -uo pipefail
input=$(cat)

# loop guard: never block twice
[ "$(jq -r '.stop_hook_active // false' <<<"$input" 2>/dev/null)" = "true" ] && exit 0

cwd=$(jq -r '.cwd // ""' <<<"$input" 2>/dev/null)
idx="$cwd/.claude/clio/index.jsonl"
[ -f "$idx" ] || exit 0                                   # project doesn't use the structure
git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || exit 0   # no git, no reliable signal

changed=$(git -C "$cwd" status --porcelain 2>/dev/null | awk '{print $NF}' | grep -v '^\.claude/')
[ -n "$changed" ] || exit 0

# anything changed more recently than the ledger was written = not yet recorded
undoc=$(cd "$cwd" && printf '%s\n' "$changed" | while IFS= read -r f; do
  [ -e "$f" ] && [ "$f" -nt "$idx" ] && printf '%s\n' "$f"
done)
n=$(printf '%s' "$undoc" | grep -c . || true)
[ "$n" -eq 0 ] && exit 0

jq -n --argjson n "$n" --arg files "$(printf '%s' "$undoc" | head -5)" '{
  hookSpecificOutput: {
    hookEventName: "Stop",
    decision: "continue",
    reason: ("\($n) file(s) changed since index.jsonl was last written, so this work is in no ledger:\n\($files)\n\nRun /clio-memo, or tell the user in one line why it needs no record (throwaway experiment, reverted, docs-only). Do not skip it silently.")
  }}'
exit 2
